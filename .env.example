# Use an identical random token in the installed Mods/BigFishBridge/config.json
BIGFISH_TOKEN=replace-with-a-random-secret
BIGFISH_PORT=45931
# Set "say" to enable macOS built-in speech, omit for silent captions.
BIGFISH_TTS=say

# Optional Pi SDK model override. Match ~/.pi/agent/models.json provider and ID.
# Leave both unset to use Pi's saved default model.
# BIGFISH_PROVIDER=newapi
# BIGFISH_MODEL=glm-5.1
# BIGFISH_THINKING=low
# Custom provider key should live in your shell, never committed:
# NEWAPI_API_KEY=your-local-secret
